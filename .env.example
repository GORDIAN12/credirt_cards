VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usuario público del bot (sin @), solo para el enlace en ajustes. Ej: MiBotChems
VITE_TELEGRAM_BOT_USERNAME=

# Token del bot — SOLO en Netlify / netlify dev (nunca con prefijo VITE_)
# Un bot para todos; cada usuario guarda su propio chat_id en profiles.
TELEGRAM_BOT_TOKEN=
# Fallback opcional (si alguien no tiene chat_id personal)
TELEGRAM_CHAT_ID=
